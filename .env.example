# Database connection string from Neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Reddit API Credentials (register at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=DigitalGuardApp/1.0.0

# SerpApi Key (register at https://serpapi.com for event discovery)
SERP_API_KEY=your_serpapi_key

# Google reCAPTCHA v3 Secret Key (get from https://www.google.com/recaptcha/admin)
RECAPTCHA_SECRET_KEY=your_secret_key

# Google reCAPTCHA v3 Site Key (get from https://www.google.com/recaptcha/admin)
RECAPTCHA_SITE_KEY=your_site_key
