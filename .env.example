# Database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Encryption (64-character hex string = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# IPFS Pinning (Pinata)
PINATA_JWT=

# Blockchain Ledger (set to "simulated" for testnet, leave empty for local-only)
LEDGER_NETWORK=

# Admin
ADMIN_SECRET=

# reCAPTCHA
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# OpenRouter (AI features)
OPENROUTER_API_KEY=
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=

# Search
SERP_API_KEY=

# Community Sync
COMM_RSS_FEEDS=
COMM_SYNC_INTERVAL_MINUTES=60
REDDIT_USER_AGENT=

# Server
PORT=3000
NODE_ENV=production
