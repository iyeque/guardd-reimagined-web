{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/start.ts",
    "build": "vite build && esbuild server/start.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "prebuild": "node scripts/generate-sitemap.mjs && npm run build:extension",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "NODE_ENV=production node dist/start.js",
    "update-data": "tsx scripts/update-community-data.ts",
    "check": "tsc",
    "build:extension": "esbuild shared/commitment-rules.ts --bundle --format=iife --global-name=DGRules --platform=browser --outfile=extension/rules.js && esbuild shared/chapters.ts --bundle --format=iife --global-name=DGChapters --platform=browser --outfile=extension/chapters.js",
    "test": "vitest run",
    "pretest": "npm run build:extension",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@neondatabase/serverless": "^0.10.4",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tanstack/react-query": "^5.56.2",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.15.0",
    "baseline-browser-mapping": "^2.9.19",
    "caniuse-lite": "^1.0.30001767",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "connect-pg-simple": "^10.0.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.6.1",
    "driver.js": "^1.8.0",
    "drizzle-orm": "^0.39.1",
    "drizzle-zod": "^0.7.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.34.3",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "ogl": "^1.0.11",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.26.2",
    "rss-parser": "^3.13.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "ws": "^8.18.0",
    "zod": "^4.6.7",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.3",
    "@replit/vite-plugin-shadcn-theme-json": "^0.0.4",
    "@tailwindcss/typography": "^0.5.15",
    "@types/axios": "^0.9.36",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/file-saver": "^2.0.7",
    "@types/html2pdf.js": "^0.10.0",
    "@types/node": "^22.5.5",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.4",
    "esbuild": "^0.25.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "lovable-tagger": "^1.1.7",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "tsx": "^4.19.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "vitest": "^2.1.9"
  }
}
